{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://any-gender-parenthook.invalid/schema/install-journal-v1.json",
  "title": "Any-Gender Parenthook transaction journal (schema v1)",
  "description": "A crash-recovery journal. It is authoritative during a transaction and is deleted only after commit or a verified rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "transaction_id",
    "operation",
    "source_state",
    "target_state",
    "phase",
    "target",
    "entries",
    "foreign_cleanup"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://any-gender-parenthook.invalid/schema/install-journal-v1.json"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "agp_install_journal"
    },
    "transaction_id": {
      "$ref": "#/$defs/uuid"
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "uninstall"
      ]
    },
    "source_state": {
      "type": "string",
      "enum": [
        "known_clean",
        "managed_agp",
        "legacy_agp",
        "recognized_ufg",
        "steam_updated",
        "unknown_conflicting"
      ]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "managed_agp",
        "known_clean",
        "unknown_conflicting",
        "manual_recovery_required"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "validate",
        "stage",
        "journal",
        "mutate",
        "verify",
        "commit",
        "rollback",
        "failed"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "build_id",
        "binaries_relative_path",
        "target_root_kind"
      ],
      "properties": {
        "game_id": {
          "type": "string",
          "const": "crusader_kings_iii"
        },
        "build_id": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "binaries_relative_path": {
          "$ref": "#/$defs/relativePath",
          "const": "binaries"
        },
        "target_root_kind": {
          "type": "string",
          "const": "steam_game_binaries"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journalEntry"
      }
    },
    "foreign_cleanup": {
      "$ref": "#/$defs/foreignCleanup"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*:)[^\\\\/:*?\"<>|\\x00-\\x1F]+(?:/[^\\\\/:*?\"<>|\\x00-\\x1F]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "journalEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "kind",
        "operation",
        "before",
        "staged_relative_path"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "rename",
            "replace",
            "remove",
            "restore",
            "quarantine",
            "verify_only"
          ]
        },
        "before": {
          "$ref": "#/$defs/fileObservation"
        },
        "staged_relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "after_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "after_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "ownership": {
          "type": "string",
          "enum": [
            "managed",
            "steam",
            "unknown_displaced",
            "recognized_awow_ufg"
          ]
        }
      }
    },
    "fileObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists",
        "kind"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory",
            "absent"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "is_reparse_point": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "foreignCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allowed",
        "quarantine_relative_path",
        "remove_after_commit",
        "uninstall_policy"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "recognized_awow_ufg"
          ]
        },
        "allowed": {
          "type": "boolean"
        },
        "quarantine_relative_path": {
          "$ref": "#/$defs/relativePath"
        },
        "remove_after_commit": {
          "type": "boolean"
        },
        "uninstall_policy": {
          "type": "string",
          "enum": [
            "none",
            "do_not_restore_awow_ufg"
          ]
        }
      }
    }
  }
}
